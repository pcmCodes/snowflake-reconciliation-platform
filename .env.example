# =============================================================================
# Snowflake Reconciliation Platform - connection configuration
# Copy this file to ".env" and fill in your Snowflake trial account values.
# NEVER commit your real .env file (it is gitignored).
# =============================================================================

# Snowflake account identifier, e.g. "xy12345.eu-central-1.aws" or "orgname-accountname"
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=RECON_ADMIN
SNOWFLAKE_WAREHOUSE=RECON_LOAD_WH
SNOWFLAKE_DATABASE=RECON_PLATFORM

# Optional: use key-pair auth instead of password (recommended for prod)
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
